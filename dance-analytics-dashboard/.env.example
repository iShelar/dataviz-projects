# Absolute path recommended in production. Relative paths are resolved against the app root
# (the folder that contains `data/` and `pyproject.toml`).
DANCE_ANALYTICS_DATA_PATH=data/original_dance_dataset.csv

# Optional: override default country centroids JSON
# DANCE_ANALYTICS_CENTROIDS_PATH=data/country_centroids.json

HOST=127.0.0.1
PORT=8051
DEBUG=false
LOG_LEVEL=INFO
